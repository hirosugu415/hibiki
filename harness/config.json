{
  "_comment": "実行中に編集しても、次のターンから反映されます。claude.command にはフルパスも指定できます。",
  "pollIntervalSec": 5,
  "cycleDelaySec": 30,
  "maxCycles": 100,
  "innovationEvery": 4,
  "retry": {
    "waitMinutes": 15,
    "backoffMultiplier": 2,
    "maxWaitMinutes": 120,
    "maxOutputRetries": 2
  },
  "claude": {
    "command": "claude",
    "model": "sonnet",
    "effort": null,
    "maxBudgetUsd": null,
    "timeoutMinutes": 60,
    "extraArgs": []
  },
  "app": {
    "installBeforeBuild": true,
    "demoQuery": "demo=1",
    "buildTimeoutSec": 300
  },
  "screenshots": {
    "settleMs": 700,
    "fullPage": true,
    "ignoreConsolePatterns": [
      "favicon"
    ],
    "video": {
      "enabled": false,
      "durationSec": 14,
      "viewports": [
        "desktop"
      ],
      "maxWidth": 960
    }
  },
  "repair": {
    "rollbackAfterFailures": 3
  },
  "git": {
    "push": true,
    "remote": "origin",
    "branch": "main",
    "pushTimeoutSec": 90
  }
}
